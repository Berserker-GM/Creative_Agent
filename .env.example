# Creative Frontend Engine — environment variables
# Copy this file to `.env.local` for local development.
# Never commit real API keys.

# -----------------------------------------------------------------------------
# AI providers (server-side only — never expose these to the client)
# These will be used in later milestones behind the AI provider abstraction.
# -----------------------------------------------------------------------------

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Google / Gemini
# GOOGLE_GENERATIVE_AI_API_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Public app URL (optional; useful for absolute links in later milestones)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
