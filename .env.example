# Creative Frontend Engine — environment variables
# Copy this file to `.env.local` for local development.
# Never commit real API keys.

# -----------------------------------------------------------------------------
# AI providers (server-side only — never expose these to the client)
# -----------------------------------------------------------------------------

# Gemini (official Google Gen AI SDK — @google/genai)
# Used for structured reasoning/analysis agents only (not image generation).
# The SDK also accepts GOOGLE_API_KEY; if both are set, GOOGLE_API_KEY wins.
# Server-side only — never put this in NEXT_PUBLIC_* variables.
GEMINI_API_KEY=

# Optional structured-text model override. Default: gemini-2.5-flash (stable GA).
# GEMINI_MODEL=gemini-2.5-flash

# Cloudflare Workers AI — image generation (M08)
# Free Neurons allocation available on Cloudflare accounts for development.
# Server-side only — never put these in NEXT_PUBLIC_* variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional image model override.
# Default: @cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Motion / video generation (M09)
# No genuinely free text/image-to-video API is currently wired.
# MotionPlan compilation works without a provider; generation returns 503
# until a verified free provider is selected.

# OpenAI (future milestones)
# OPENAI_API_KEY=

# Anthropic (future milestones)
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Public app URL (optional; useful for absolute links in later milestones)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
